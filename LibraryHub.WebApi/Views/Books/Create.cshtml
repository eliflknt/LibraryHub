@using Microsoft.AspNetCore.Mvc.Rendering
@model LibraryHub.WebApi.ViewModels.CreateBookViewModel

@{
    ViewData["Title"] = "Yeni Kitap Ekle";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Yeni Kitap Ekle</h1>

        <a asp-controller="MvcBooks"
           asp-action="Index"
           class="btn btn-secondary">
            Kitap Listesine Dön
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-controller="MvcBooks"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="ISBN" class="form-label">
                        ISBN
                    </label>

                    <input asp-for="ISBN"
                           class="form-control"
                           placeholder="ISBN giriniz" />

                    <span asp-validation-for="ISBN"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Kitap Başlığı
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Kitap başlığını giriniz" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="PublicationYear" class="form-label">
                        Yayın Yılı
                    </label>

                    <input asp-for="PublicationYear"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="PublicationYear"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockQuantity" class="form-label">
                        Stok Adedi
                    </label>

                    <input asp-for="StockQuantity"
                           type="number"
                           class="form-control"
                           min="0" />

                    <span asp-validation-for="StockQuantity"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="RaftakiAdet" class="form-label">
                        Raftaki Adet
                    </label>

                    <input asp-for="RaftakiAdet"
                           type="number"
                           class="form-control"
                           min="0" />

                    <span asp-validation-for="RaftakiAdet"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">
                        Kategori
                    </label>

                    <select asp-for="CategoryId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Categories, "Id", "Ad"))">

                        <option value="">
                            Kategori seçiniz
                        </option>

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Kitabı Kaydet
                </button>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}