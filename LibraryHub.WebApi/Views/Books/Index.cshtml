@model IEnumerable<LibraryHub.WebApi.ViewModels.BookViewModel>

@{
    ViewData["Title"] = "Kitaplar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Kitaplar</h1>

        <a asp-controller="MvcBooks"
           asp-action="Create"
           class="btn btn-primary">
            Yeni Kitap Ekle
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Henüz kayıtlı kitap bulunmamaktadır.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ISBN</th>
                    <th>Başlık</th>
                    <th>Yayın Yılı</th>
                    <th>Stok Adedi</th>
                    <th>Raftaki Adet</th>
                    <th>Kategori ID</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.ISBN</td>
                        <td>@book.Title</td>
                        <td>@book.PublicationYear</td>
                        <td>@book.StockQuantity</td>
                        <td>@book.RaftakiAdet</td>
                        <td>@book.CategoryId</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>